# Copy to .env and fill in.  cp .env.example .env
# .env is gitignored and never committed.

# Required. One key, every model. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Only if delivery.method is "resend". https://resend.com/api-keys
RESEND_API_KEY=

# Only if delivery.method is "webhook" and you'd rather not put the URL in YAML.
DIGEST_WEBHOOK_URL=
