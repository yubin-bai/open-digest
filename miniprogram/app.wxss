/* 全局样式。rpx 是小程序的响应式单位：屏幕宽固定 750rpx，
   所以 750rpx = 屏幕宽度，不用管具体机型。 */

page {
  background: #f5f6f8;
  color: #1f2328;
  font-size: 30rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.page {
  padding: 32rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.muted {
  color: #8c959f;
  font-size: 26rpx;
}

.title-lg {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 30rpx;
  background: #07c160;
  border-radius: 3rpx;
  margin-right: 16rpx;
}

/* 底部固定操作条，给内容留出安全区 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.btn-primary {
  flex: 1;
  background: #07c160;
  color: #fff;
  border-radius: 999rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary.disabled {
  background: #c8ccd0;
}

.btn-ghost {
  color: #07c160;
  font-size: 30rpx;
  padding: 0 12rpx;
}

.empty {
  text-align: center;
  padding: 160rpx 48rpx;
  color: #8c959f;
}

.empty .empty-title {
  font-size: 32rpx;
  color: #57606a;
  margin-bottom: 16rpx;
}
